<Window x:Class="RCF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RCF Explorer - Reality Constraint Fuzzer" 
        Height="800" Width="1200"
        Background="#1a1a2e"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ControlButton">
            <Setter Property="Background" Value="#4a5568"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5a6578"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="TextBlock" x:Key="MetricLabel">
            <Setter Property="Foreground" Value="#9ca3af"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        
        <Style TargetType="TextBlock" x:Key="MetricValue">
            <Setter Property="Foreground" Value="#60a5fa"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Control Panel -->
        <Border Grid.Column="0" Background="#1f2937" Padding="20" 
                BorderBrush="#374151" BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="RCF EXPLORER" FontSize="18" FontWeight="Bold" 
                          Foreground="#a78bfa" Margin="0,0,0,20"/>
                
                <!-- Configuration Section -->
                <TextBlock Text="CONFIGURATION" FontSize="12" Foreground="#9ca3af" 
                          Margin="0,0,0,10"/>
                
                <TextBlock Text="Dimensions" Style="{StaticResource MetricLabel}"/>
                <Slider x:Name="DimensionsSlider" Minimum="2" Maximum="8" Value="3" 
                       TickFrequency="1" IsSnapToTickEnabled="True" 
                       Margin="0,0,0,10"/>
                <TextBlock Text="{Binding ElementName=DimensionsSlider, Path=Value, StringFormat='{}{0:F0}'}" 
                          Foreground="White" FontFamily="Consolas" Margin="0,0,0,15"/>
                
                <TextBlock Text="Frames" Style="{StaticResource MetricLabel}"/>
                <Slider x:Name="FramesSlider" Minimum="50" Maximum="500" Value="200" 
                       TickFrequency="50" IsSnapToTickEnabled="True" 
                       Margin="0,0,0,10"/>
                <TextBlock Text="{Binding ElementName=FramesSlider, Path=Value, StringFormat='{}{0:F0}'}" 
                          Foreground="White" FontFamily="Consolas" Margin="0,0,0,20"/>
                
                <!-- Control Buttons -->
                <Button x:Name="RunButton" Content="▶ RUN" 
                       Style="{StaticResource ControlButton}" 
                       Click="RunButton_Click"
                       Background="#10b981"/>
                
                <Button x:Name="PauseButton" Content="⏸ PAUSE" 
                       Style="{StaticResource ControlButton}"
                       IsEnabled="False"
                       Click="PauseButton_Click"
                       Background="#f59e0b"/>
                
                <Button x:Name="ResetButton" Content="↻ RESET" 
                       Style="{StaticResource ControlButton}"
                       Click="ResetButton_Click"
                       Background="#6366f1"/>
                
                <Button x:Name="ExportButton" Content="⤓ EXPORT DATA" 
                       Style="{StaticResource ControlButton}"
                       Click="ExportButton_Click"
                       Background="#059669"/>
                
                <!-- Current Status -->
                <Border Background="#111827" Padding="15" Margin="0,20,0,0" 
                       CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="CURRENT STATUS" FontSize="12" 
                                  Foreground="#9ca3af" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Volley" Style="{StaticResource MetricLabel}"/>
                        <TextBlock x:Name="VolleyText" Text="0/200" 
                                  Style="{StaticResource MetricValue}"/>
                        
                        <TextBlock Text="Magnitude" Style="{StaticResource MetricLabel}" 
                                  Margin="0,10,0,0"/>
                        <TextBlock x:Name="MagnitudeText" Text="0.000" 
                                  Style="{StaticResource MetricValue}"/>
                        
                        <TextBlock Text="Global Stress" Style="{StaticResource MetricLabel}" 
                                  Margin="0,10,0,0"/>
                        <TextBlock x:Name="StressText" Text="0.000" 
                                  Style="{StaticResource MetricValue}"
                                  Foreground="#f87171"/>
                    </StackPanel>
                </Border>
                
                <!-- Collapse Warning -->
                <Border x:Name="CollapsePanel" Background="#7f1d1d" 
                       BorderBrush="#dc2626" BorderThickness="1"
                       Padding="15" Margin="0,10,0,0" CornerRadius="5"
                       Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="⚠ COLLAPSE DETECTED" FontSize="12" 
                                  Foreground="#fca5a5" FontWeight="Bold"/>
                        <TextBlock x:Name="CollapseMessage" Text="" 
                                  FontSize="11" Foreground="#fecaca" 
                                  TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Stable Run Success -->
                <Border x:Name="StablePanel" Background="#064e3b" 
                       BorderBrush="#059669" BorderThickness="1"
                       Padding="15" Margin="0,10,0,0" CornerRadius="5"
                       Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="✓ STABLE RUN ACHIEVED" FontSize="12" 
                                  Foreground="#6ee7b7" FontWeight="Bold"/>
                        <TextBlock Text="The dance continued without collapse." 
                                  FontSize="11" Foreground="#a7f3d0" 
                                  FontStyle="Italic" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        
        <!-- Right Visualization Panel -->
        <Grid Grid.Column="1" Background="#111827">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#1f2937"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="15,10"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </TabControl.Resources>
                
                <!-- Magnitude Over Time -->
                <TabItem Header="📊 Magnitude Timeline">
                    <Border Padding="20">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" 
                                      Text="State Magnitude Evolution" 
                                      FontSize="16" Foreground="White" 
                                      Margin="0,0,0,15"/>
                            <Canvas x:Name="MagnitudeCanvas" 
                                   Background="#0a0e1a"
                                   ClipToBounds="True"/>
                        </DockPanel>
                    </Border>
                </TabItem>
                
                <!-- Intent vs Memory -->
                <TabItem Header="🎯 Phase Space">
                    <Border Padding="20">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" 
                                      Text="Intent vs Memory Phase Space" 
                                      FontSize="16" Foreground="White" 
                                      Margin="0,0,0,15"/>
                            <Canvas x:Name="PhaseCanvas" 
                                   Background="#0a0e1a"
                                   ClipToBounds="True"/>
                        </DockPanel>
                    </Border>
                </TabItem>
                
                <!-- Narrative Log -->
                <TabItem Header="📜 Narrative">
                    <Border Padding="20">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" 
                                      Text="Emergent Narrative" 
                                      FontSize="16" Foreground="White" 
                                      Margin="0,0,0,15"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="NarrativeLog">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1f2937" 
                                                   BorderBrush="#a78bfa" 
                                                   BorderThickness="2,0,0,0"
                                                   Padding="15,10" Margin="0,5">
                                                <TextBlock Text="{Binding}" 
                                                          Foreground="#d1d5db" 
                                                          FontStyle="Italic"
                                                          TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </TabItem>
                
                <!-- Law Scores -->
                <TabItem Header="⚖️ Law Scores">
                    <Border Padding="20">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" 
                                      Text="Constraint Survival Metrics" 
                                      FontSize="16" Foreground="White" 
                                      Margin="0,0,0,15"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="LawScoresList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1f2937" 
                                                   Padding="15" Margin="0,5"
                                                   CornerRadius="5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" 
                                                                  Foreground="White" 
                                                                  FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Description}" 
                                                                  Foreground="#9ca3af" 
                                                                  FontSize="11" 
                                                                  TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" 
                                                              Text="{Binding Score, StringFormat='{}{0:F4}'}" 
                                                              Foreground="#a78bfa" 
                                                              FontFamily="Consolas"
                                                              FontSize="18"
                                                              FontWeight="Bold"
                                                              VerticalAlignment="Center"
                                                              Margin="20,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
